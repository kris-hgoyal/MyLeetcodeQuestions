/**
 * @param {string} blocks
 * @param {number} k
 * @return {number}
 */
var minimumRecolors = function(blocks, k) {
    let count =0;
    let min_count = Infinity;
    for(i=0; i<k ; i++){
        if(blocks[i]=="W") count++;
    }
    min_count = Math.min(count,min_count);
    for(i=1; i<=blocks.length-k ; i++){
        if(blocks[i-1]=='W') count--;
        if(blocks[i+k-1]=='W') count++;
        min_count = Math.min(count,min_count);
    }
    
    return min_count;
};
