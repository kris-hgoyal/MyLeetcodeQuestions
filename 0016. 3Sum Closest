/**
 * @param {number[]} nums
 * @param {number} target
 * @return {number}
 */
var threeSumClosest = function(nums, target) {
    nums.sort((a, b) => a - b);

    let ans = 0;
    let minDiff = Infinity;

    for (let i = 0; i < nums.length; i++) {
        let l = i + 1;
        let r = nums.length - 1;
        while (l < r) {
            let sum = nums[i] + nums[l] + nums[r];
            let diff = Math.abs(sum - target);
            if (diff < minDiff) {
                minDiff = diff;
                ans = sum;
            }
            if (sum < target) l++;
            else if (sum > target) r--;
            else return sum;
        }
    }

    return ans;

};
